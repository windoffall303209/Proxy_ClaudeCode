<%# Trung tâm quản lí trang web: cấu hình nhận diện, giao diện, nội dung và vận hành. %>
<%- include('../partials/admin-header', {
    currentPage: 'storefront',
    pageStyles: ['/css/admin/storefront.css', '/css/admin/api-keys.css']
}) %>

<%
    const state = settingsState || {};
    const groups = Array.isArray(settingGroups) ? settingGroups : [];
    const definitions = settingDefinitions || {};
    const keys = Array.isArray(apiKeys) ? apiKeys : [];
    const providers = Array.isArray(providerOptions) ? providerOptions : [];
    const currentValues = state.inputValues || settings || {};
    const publishedValues = state.publishedValues || {};
    const currentActiveSection = typeof activeSection !== 'undefined' && activeSection
        ? activeSection
        : '';

    function inputValue(key) {
        const value = currentValues[key];
        if (value === undefined || value === null) return '';
        return value;
    }

    function publishedValue(key) {
        const value = publishedValues[key];
        if (value === undefined || value === null) return '';
        return value;
    }

    function isChecked(key) {
        const value = currentValues[key];
        return value === true || value === 'true' || value === 1 || value === '1';
    }

    function isLongText(definition) {
        return definition.type === 'json' || Number(definition.maxLength || 0) > 220;
    }

    function providerLabel(value) {
        const provider = providers.find((item) => item.value === value);
        return provider ? provider.label : value;
    }
%>

<div class="admin-page" data-website-management data-active-section="<%= currentActiveSection %>">
    <div class="container">
        <div class="admin-page-header">
            <div class="admin-page-header__left">
                <h1>Quản lí trang web</h1>
            </div>
        </div>

        <% if (notice) { %>
            <div class="storefront-notice storefront-notice--<%= noticeType === 'error' ? 'error' : (noticeType === 'warning' ? 'warning' : 'success') %>">
                <%= notice %>
            </div>
        <% } %>

        <div class="website-management-shell">
            <aside class="website-management-sidebar" aria-label="Danh sách chức năng quản lí trang web">
                <div class="website-management-sidebar__head">
                    <strong>Chức năng</strong>
                    <% if (state.hasDraft) { %>
                        <span><%= state.draftKeys.length %> mục nháp</span>
                    <% } else { %>
                        <span>Đã áp dụng</span>
                    <% } %>
                </div>

                <div class="website-management-menu" data-website-menu>
                    <% groups.forEach((group) => { %>
                        <button
                            type="button"
                            class="website-management-card"
                            data-website-section-target="<%= group.key %>"
                        >
                            <span><%= group.title %></span>
                            <% if (group.hasDraft) { %>
                                <em>Có <%= group.draftCount %> bản nháp</em>
                            <% } else { %>
                                <em>Đã áp dụng</em>
                            <% } %>
                        </button>
                    <% }) %>
                    <button
                        type="button"
                        class="website-management-card"
                        data-website-section-target="api_keys"
                    >
                        <span>API keys</span>
                        <% if (keys.length) { %>
                            <em><%= keys.length %> key</em>
                        <% } else { %>
                            <em>Chưa cấu hình</em>
                        <% } %>
                    </button>
                </div>
            </aside>

            <div class="website-management-content">
                <% groups.forEach((group) => { %>
                    <section class="admin-section website-management-panel" data-website-section="<%= group.key %>" hidden>
                        <div class="website-management-panel__top">
                            <button type="button" class="admin-btn admin-btn--ghost website-management-back" data-website-back aria-label="Quay lại danh sách" title="Quay lại danh sách">&larr;</button>
                            <div>
                                <h3 class="admin-section__title"><%= group.title %></h3>
                            </div>
                            <span class="website-management-status <%= group.hasDraft ? 'website-management-status--draft' : '' %>">
                                <%= group.hasDraft ? 'Có bản nháp' : 'Đã áp dụng' %>
                            </span>
                        </div>

                        <form action="/admin/storefront/draft" method="POST" class="admin-form storefront-settings-form">
                            <input type="hidden" name="active_group" value="<%= group.key %>">

                            <div class="storefront-settings-grid">
                                <% group.keys.forEach((key) => { %>
                                    <% const definition = definitions[key] || {}; %>
                                    <div class="storefront-settings-card storefront-settings-card--<%= definition.type || 'string' %>">
                                        <div class="storefront-settings-card__label-row">
                                            <label class="admin-form__label" for="setting-<%= key %>"><%= definition.label || key %></label>
                                            <% if (state.draftKeys && state.draftKeys.includes(key)) { %>
                                                <span class="storefront-settings-card__draft">Nháp</span>
                                            <% } %>
                                        </div>

                                        <% if (definition.type === 'boolean') { %>
                                            <input type="hidden" name="<%= key %>" value="false">
                                            <label class="website-toggle">
                                                <input
                                                    id="setting-<%= key %>"
                                                    type="checkbox"
                                                    name="<%= key %>"
                                                    value="true"
                                                    <%= isChecked(key) ? 'checked' : '' %>
                                                >
                                                <span></span>
                                                <strong><%= isChecked(key) ? 'Đang bật' : 'Đang tắt' %></strong>
                                            </label>
                                        <% } else if (definition.type === 'select') { %>
                                            <select id="setting-<%= key %>" name="<%= key %>" class="admin-form__select">
                                                <% (definition.options || []).forEach((option) => { %>
                                                    <option value="<%= option.value %>" <%= String(inputValue(key)) === String(option.value) ? 'selected' : '' %>><%= option.label %></option>
                                                <% }) %>
                                            </select>
                                        <% } else if (definition.type === 'int') { %>
                                            <input
                                                id="setting-<%= key %>"
                                                type="number"
                                                name="<%= key %>"
                                                class="admin-form__input"
                                                min="<%= definition.min ?? '' %>"
                                                max="<%= definition.max ?? '' %>"
                                                value="<%= inputValue(key) %>"
                                            >
                                        <% } else if (definition.type === 'color') { %>
                                            <div class="website-color-input">
                                                <input id="setting-<%= key %>" type="color" name="<%= key %>" value="<%= inputValue(key) %>">
                                                <code><%= inputValue(key) %></code>
                                            </div>
                                        <% } else if (definition.type === 'image') { %>
                                            <div class="website-asset-field" data-storefront-asset>
                                                <div class="website-asset-field__preview">
                                                    <% if (inputValue(key)) { %>
                                                        <img src="<%= inputValue(key) %>" alt="<%= definition.label || key %>" data-storefront-asset-preview>
                                                    <% } else { %>
                                                        <span data-storefront-asset-preview>Chưa có ảnh</span>
                                                    <% } %>
                                                </div>
                                                <input
                                                    id="setting-<%= key %>"
                                                    type="text"
                                                    name="<%= key %>"
                                                    class="admin-form__input"
                                                    value="<%= inputValue(key) %>"
                                                    data-storefront-asset-value
                                                >
                                                <label class="admin-btn admin-btn--ghost website-asset-field__button">
                                                    Upload ảnh
                                                    <input type="file" accept="image/*" data-storefront-asset-input hidden>
                                                </label>
                                            </div>
                                        <% } else if (definition.type === 'json' || isLongText(definition)) { %>
                                            <textarea
                                                id="setting-<%= key %>"
                                                name="<%= key %>"
                                                class="admin-form__textarea"
                                                rows="<%= definition.type === 'json' ? 5 : 3 %>"
                                            ><%= inputValue(key) %></textarea>
                                        <% } else { %>
                                            <input
                                                id="setting-<%= key %>"
                                                type="text"
                                                name="<%= key %>"
                                                class="admin-form__input"
                                                maxlength="<%= definition.maxLength || 500 %>"
                                                value="<%= inputValue(key) %>"
                                            >
                                        <% } %>

                                        <% if (publishedValue(key) !== '' && String(publishedValue(key)) !== String(inputValue(key))) { %>
                                            <p class="storefront-settings-card__hint">Đang áp dụng: <code><%= typeof publishedValue(key) === 'object' ? JSON.stringify(publishedValue(key)) : publishedValue(key) %></code></p>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="website-management-panel__actions">
                                <button type="submit" class="admin-btn admin-btn--primary">Lưu nháp</button>
                            </div>
                        </form>

                        <div class="website-management-panel__secondary-actions">
                            <form action="/admin/storefront/publish" method="POST">
                                <input type="hidden" name="active_group" value="<%= group.key %>">
                                <button type="submit" class="admin-btn admin-btn--success" <%= group.hasDraft ? '' : 'disabled' %>>Áp dụng</button>
                            </form>
                            <form action="/admin/storefront/discard" method="POST">
                                <input type="hidden" name="active_group" value="<%= group.key %>">
                                <button type="submit" class="admin-btn admin-btn--ghost" <%= group.hasDraft ? '' : 'disabled' %>>Bỏ nháp</button>
                            </form>
                            <form action="/admin/storefront/reset" method="POST">
                                <input type="hidden" name="active_group" value="<%= group.key %>">
                                <button type="submit" class="admin-btn admin-btn--danger">Khôi phục mặc định</button>
                            </form>
                            <% if (group.key === 'banner_popup') { %>
                                <a href="/admin/banners" class="admin-btn admin-btn--ghost">Mở Quản lí banner</a>
                            <% } %>
                        </div>
                    </section>
                <% }) %>

                <section class="admin-section website-management-panel api-key-page" data-website-section="api_keys" hidden>
                    <div class="website-management-panel__top">
                        <button type="button" class="admin-btn admin-btn--ghost website-management-back" data-website-back aria-label="Quay lại danh sách" title="Quay lại danh sách">&larr;</button>
                        <div>
                            <h3 class="admin-section__title">API keys</h3>
                            <p class="storefront-settings__description">Quản lý key runtime cho Gemini CLI và các tích hợp server-side. Key chỉ hiển thị ở dạng đã che.</p>
                        </div>
                        <span class="website-management-status <%= keys.length ? '' : 'website-management-status--draft' %>">
                            <%= keys.length ? `${keys.length} key` : 'Chưa cấu hình' %>
                        </span>
                    </div>

                    <div class="api-key-toolbar">
                        <div>
                            <h2 class="admin-section__title">Thêm API key</h2>
                            <p>Với chatbot hiện tại, dùng provider <strong>Gemini CLI</strong> và tên biến <strong>GEMINI_API_KEY</strong>.</p>
                        </div>
                    </div>

                    <form action="/admin/api-keys" method="POST" class="admin-form api-key-form api-key-form--create">
                        <div class="api-key-form__grid">
                            <div class="admin-form__field">
                                <label class="admin-form__label" for="provider">Provider</label>
                                <select id="provider" name="provider" class="admin-form__input">
                                    <% providers.forEach((provider) => { %>
                                        <option value="<%= provider.value %>" <%= provider.value === 'gemini_cli' ? 'selected' : '' %>><%= provider.label %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="admin-form__field">
                                <label class="admin-form__label" for="key_name">Tên biến</label>
                                <input id="key_name" class="admin-form__input" type="text" name="key_name" value="GEMINI_API_KEY" maxlength="100" required>
                            </div>
                            <div class="admin-form__field api-key-form__secret">
                                <label class="admin-form__label" for="key_value">API key</label>
                                <input id="key_value" class="admin-form__input" type="password" name="key_value" placeholder="Nhập API key mới" autocomplete="new-password" required>
                            </div>
                            <div class="admin-form__field">
                                <label class="admin-form__label" for="notes">Ghi chú</label>
                                <input id="notes" class="admin-form__input" type="text" name="notes" maxlength="255" placeholder="VD: Google AI Studio key">
                            </div>
                        </div>

                        <div class="api-key-form__actions">
                            <input type="hidden" name="is_active" value="false">
                            <label class="api-key-toggle">
                                <input type="checkbox" name="is_active" value="true" checked>
                                <span>Đang bật</span>
                            </label>
                            <button type="submit" class="admin-btn admin-btn--primary">Lưu API key</button>
                        </div>
                    </form>

                    <div class="api-key-toolbar api-key-toolbar--list">
                        <div>
                            <h2 class="admin-section__title">Danh sách API key</h2>
                            <p>Nhập key mới nếu muốn thay đổi giá trị. Nếu để trống, hệ thống chỉ cập nhật provider, tên biến, trạng thái và ghi chú.</p>
                        </div>
                    </div>

                    <% if (!keys.length) { %>
                        <div class="api-key-empty">
                            <strong>Chưa có API key nào.</strong>
                            <span>Hãy thêm GEMINI_API_KEY để chatbot có thể dùng API key thay cho Google login khi Gemini CLI hỗ trợ.</span>
                        </div>
                    <% } else { %>
                        <div class="api-key-table-wrapper">
                            <% keys.forEach((item) => { %>
                                <form id="api-key-update-<%= item.id %>" action="/admin/api-keys/<%= item.id %>" method="POST"></form>
                                <form id="api-key-delete-<%= item.id %>" action="/admin/api-keys/<%= item.id %>/delete" method="POST"></form>
                            <% }) %>

                            <table class="api-key-table">
                                <thead>
                                    <tr>
                                        <th>Provider</th>
                                        <th>Tên biến</th>
                                        <th>Key đã che</th>
                                        <th>Trạng thái</th>
                                        <th>Ghi chú</th>
                                        <th>Key mới</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% keys.forEach((item) => { %>
                                        <tr>
                                            <td data-label="Provider">
                                                <select id="provider-<%= item.id %>" name="provider" class="admin-form__input api-key-table__control" form="api-key-update-<%= item.id %>">
                                                    <% providers.forEach((provider) => { %>
                                                        <option value="<%= provider.value %>" <%= provider.value === item.provider ? 'selected' : '' %>><%= provider.label %></option>
                                                    <% }) %>
                                                </select>
                                            </td>
                                            <td data-label="Tên biến">
                                                <input id="key-name-<%= item.id %>" class="admin-form__input api-key-table__control api-key-table__mono" type="text" name="key_name" value="<%= item.key_name %>" maxlength="100" required form="api-key-update-<%= item.id %>">
                                            </td>
                                            <td data-label="Key đã che">
                                                <code class="api-key-masked"><%= item.masked_value || 'Chưa có giá trị' %></code>
                                            </td>
                                            <td data-label="Trạng thái">
                                                <input type="hidden" name="is_active" value="false" form="api-key-update-<%= item.id %>">
                                                <label class="api-key-switch">
                                                    <input type="checkbox" name="is_active" value="true" <%= item.is_active ? 'checked' : '' %> form="api-key-update-<%= item.id %>">
                                                    <span aria-hidden="true"></span>
                                                    <strong><%= item.is_active ? 'Đang bật' : 'Đang tắt' %></strong>
                                                </label>
                                            </td>
                                            <td data-label="Ghi chú">
                                                <input id="notes-<%= item.id %>" class="admin-form__input api-key-table__control" type="text" name="notes" value="<%= item.notes || '' %>" maxlength="255" placeholder="Không có ghi chú" form="api-key-update-<%= item.id %>">
                                            </td>
                                            <td data-label="Key mới">
                                                <input id="key-value-<%= item.id %>" class="admin-form__input api-key-table__control" type="password" name="key_value" placeholder="Để trống nếu không đổi" autocomplete="new-password" form="api-key-update-<%= item.id %>">
                                            </td>
                                            <td data-label="Thao tác">
                                                <div class="api-key-table__actions">
                                                    <button type="submit" class="admin-btn admin-btn--primary api-key-action-btn" form="api-key-update-<%= item.id %>">Cập nhật</button>
                                                    <button type="submit" class="admin-btn admin-btn--ghost api-key-delete-btn api-key-action-btn" form="api-key-delete-<%= item.id %>" onclick="return confirm('Xóa API key này?');">Xóa</button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </section>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/storefront.js?v=api-keys-20260601"></script>

<%- include('../partials/admin-footer') %>
